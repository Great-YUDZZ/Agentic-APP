{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nodra",
  "mainBinaryName": "nodra",
  "version": "0.4.10",
  "identifier": "com.agentic.nativehub",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nodra",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Nodra",
    "longDescription": "Nodra: Desktop Multi-Agent Studio and Coding Assistant",
    "copyright": "Copyright 2026 Nodra",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libayatana-appindicator3-1 | libappindicator3-1",
          "libssl3 | libssl1.1"
        ],
        "section": "devel"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBQUU0NTFERkFDQTNDOTgKUldTWVBNcjZIVVd1Q25zK0ZZTHdzcnhkNWVBNkJhODdSTnBCb3FKdndGWU83N3N2eUJ0TlNOL2IK",
      "endpoints": [
        "https://github.com/Great-YUDZZ/nodra/releases/latest/download/latest.json"
      ]
    }
  }
}
